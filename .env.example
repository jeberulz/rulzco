# ─── Recraft.ai (editorial image generation for /news articles) ─────
# Get a key at https://www.recraft.ai/account (free tier ≈ 50 credits/day)
# One V3 image ≈ 1 credit ≈ $0.04 on paid tier.
RECRAFT_API_KEY=

# Optional overrides for scripts/generate-news-images.ts
# Custom Recraft style ID (UUID from your Recraft account). When set, this
# overrides RECRAFT_STYLE and RECRAFT_SUBSTYLE below.
RECRAFT_STYLE_ID=
# Built-in style options: digital_illustration | realistic_image | vector_illustration
RECRAFT_STYLE=digital_illustration
# Substyle is optional. Examples for digital_illustration: grain, 2d_art_poster,
# hand_drawn, engraving_color. Leave empty for the style's default.
RECRAFT_SUBSTYLE=
# Size: 1820x1024 is 16:9 widescreen, ideal for editorial card thumbnails.
RECRAFT_SIZE=1820x1024
# Set FORCE=1 to regenerate images that already exist.
FORCE=
